# ==================== BugMind 后端环境变量配置 ====================
# 使用方法：
#   1) 复制本文件为 .env（同一个目录下），例如：
#        Windows PowerShell:  Copy-Item .env.example .env
#   2) 在 .env 中填写 DEEPSEEK_API_KEY（必填），保存后重启后端服务
#   3) .env 已被 .gitignore 忽略，不要把真实 Key 提交到仓库
#
# ⚠️ 真实 Key 只能写进「复制出来的 .env」，不要写在本文件（.env.example）里：
#    本文件是随代码分发的模板，写了真 Key 一旦分享/打包就等于泄露。
#
# 加载顺序（后端自动查找，先找到的优先）：
#   项目根目录/.env  →  后端/.env  →  当前工作目录/.env
#   推荐直接放在项目根目录（与「前端」「后端」两个文件夹同级）

# ---------------------------------------------------------------
# 【必填】DeepSeek 大模型 API Key
# 获取方式：DeepSeek 开放平台 https://platform.deepseek.com → API Keys → 创建
# 格式：sk- 开头的一串字符，例如 DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 安全：只保存在本机 .env 中，后端服务端发起 HTTPS 请求，绝不下发到前端
# ---------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------
# 【可选】模型名称（默认 deepseek-v4.1-flash，不要加引号）
# ---------------------------------------------------------------
DEEPSEEK_MODEL=deepseek-v4.1-flash

# ---------------------------------------------------------------
# 【可选】接口地址（DeepSeek 官方 OpenAI 兼容接口，一般无需修改）
# ---------------------------------------------------------------
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ---------------------------------------------------------------
# 【可选】大模型调用超时（秒）与输出上限
# ---------------------------------------------------------------
API_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ---------------------------------------------------------------
# 【可选】是否要求上游返回 JSON 对象（上游不支持时会自动降级为文本模式）
# ---------------------------------------------------------------
LLM_JSON_MODE=true

# ---------------------------------------------------------------
# 【可选】入参长度限制（字符），防止滥用
# ---------------------------------------------------------------
MAX_CODE_LENGTH=8000
MAX_PROBLEM_LENGTH=2000
MAX_ERROR_LENGTH=2000

# ---------------------------------------------------------------
# 【可选】服务端口（前端默认请求 http://127.0.0.1:8000）
# ---------------------------------------------------------------
PORT=8000
